# ApplyPilot environment configuration
# Copy to ~/.applypilot/.env (applypilot init writes this for you).

# --- AI provider ------------------------------------------------------------
# codex     = sign in with ChatGPT (run `applypilot login`); uses your Plus/Pro plan
# anthropic = Claude API key
# gemini | openai | local = upstream providers
LLM_PROVIDER=codex

# Claude API key. With LLM_PROVIDER=codex it is used automatically if ChatGPT
# usage limits are hit (set LLM_FALLBACK=0 to disable that).
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=            # model for the fallback (default claude-opus-5-5)

# LLM_MODEL=                  # override the model for the chosen provider
# APPLY_LLM_PROVIDER=         # use a different provider for the browser agent only
# APPLY_LLM_MODEL=
# CODEX_EFFORT=medium         # low | medium | high
# ANTHROPIC_EFFORT=medium     # low | medium | high | xhigh | max

# Upstream providers
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# LLM_URL=http://127.0.0.1:8080/v1

# --- Auto-apply (optional) ----------------------------------------------------
# CAPSOLVER_API_KEY=          # CAPTCHA solving
# APPLY_GMAIL_MCP=1           # let the agent read email verification codes (Gmail MCP)
# APPLY_MAX_TURNS=120         # max agent steps per application
# APPLY_CLONE_CHROME_PROFILE=0  # 1 = copy your real Chrome profile (not recommended)
# PLAYWRIGHT_MCP_PACKAGE=@playwright/mcp@0.0.85

# --- Discovery (optional) -----------------------------------------------------
# PROXY=host:port:user:pass
